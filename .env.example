# Required: protects both the web UI's server requests and the Bitwarden endpoint.
SERVER_API_TOKEN=replace_with_a_long_random_secret

# Optional for web-only use: enter provider settings in the web UI instead.
# Required for standalone API and Bitwarden alias creation.
ALIAS_PROVIDER=purelymail
PURELYMAIL_API_KEY=your_provider_key

# For MXRoute instead:
# ALIAS_PROVIDER=mxroute
# MXROUTE_SERVER=your_server.mxrouting.net
# MXROUTE_USERNAME=your_username
# MXROUTE_API_KEY=your_provider_key

# Optional: allow a separately hosted web UI to call the API across origins.
# EAG_ALLOWED_ORIGINS=https://your-web.example
